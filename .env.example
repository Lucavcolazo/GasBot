# Telegram — token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# Opcional pero recomendado: string random propio, se manda como secret_token
# al configurar el webhook y se valida en cada request para confirmar que
# viene realmente de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Nota: TELEGRAM_ALLOWED_CHAT_ID y TELEGRAM_USER_ID ya no se usan. Cada
# usuario vincula su propio Telegram desde Configuracion en la app web
# (tabla telegram_links, ver api/telegram/link.ts y api/webhook.ts).

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cron de recordatorios (api/cron/recordatorios.ts). String random propio;
# Vercel lo manda como header "Authorization: Bearer <CRON_SECRET>" en cada
# invocacion de cron automaticamente si esta seteado en las env vars del
# proyecto. Opcional pero recomendado para que nadie mas pueda pegarle a ese
# endpoint y disparar notificaciones.
CRON_SECRET=

# Supabase — Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Frontend (Vite expone solo las que empiezan con VITE_) — mismo proyecto,
# pero con la publishable key, nunca la secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
