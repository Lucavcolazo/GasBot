# Telegram — token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# Opcional pero recomendado: string random propio, se manda como secret_token
# al configurar el webhook y se valida en cada request para confirmar que
# viene realmente de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite expone solo las que empiezan con VITE_) — mismos valores
# que SUPABASE_URL, pero con la anon key, no la service role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
