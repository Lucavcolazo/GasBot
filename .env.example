# Telegram — token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# Opcional pero recomendado: string random propio, se manda como secret_token
# al configurar el webhook y se valida en cada request para confirmar que
# viene realmente de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Bot privado: el unico chat_id que el bot va a procesar. Al principio dejalo
# vacio, mandale /start al bot, te va a contestar con tu chat id, y recien
# ahi lo cargas aca (y en Vercel) para que el bot ignore a todos los demas.
TELEGRAM_ALLOWED_CHAT_ID=

# UUID del usuario de Supabase Auth (el tuyo, el que usas para loguearte en
# el dashboard web) al que se le van a atribuir los movimientos que cargue el
# bot. Se saca de Authentication > Users en el dashboard de Supabase.
TELEGRAM_USER_ID=

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Frontend (Vite expone solo las que empiezan con VITE_) — mismo proyecto,
# pero con la publishable key, nunca la secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
